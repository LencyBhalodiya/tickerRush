NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ticker-rush
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Development: a free test inbox from https://ethereal.email (nothing is really delivered).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=replace-with-your-ethereal-username@ethereal.email
SMTP_PASS=replace-with-your-ethereal-password
MAIL_FROM="tickerRush <no-reply@tickerrush.dev>"
